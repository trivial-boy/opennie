# Docker Production Environment Configuration
DEBUG=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Configuration (MySQL)
DATABASE_URL=mysql+aiomysql://user:opennie%40123@mysql:3306/accounting_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://:opennie%40123@redis:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true

# Security Configuration - 生产环境请修改这些密钥
SECRET_KEY=prod-secret-key-change-this-in-production
JWT_SECRET_KEY=prod-jwt-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration - 根据实际前端地址调整
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://172.16.2.50:3000,http://172.16.2.50:8000,*
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=60

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.xlsx,.csv

# Email Verification - 生产环境建议启用
EMAIL_VERIFICATION_ENABLED=false

# Email Configuration - 配置实际的邮件服务
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=记账App

# Frontend URL
FRONTEND_URL=http://localhost:3000

# 百度OCR配置
BAIDU_OCR_API_KEY=GXDbWbONIc6cjyIBrLQ6sZRQ
BAIDU_OCR_SECRET_KEY=AZIpImsP1oTSWw1UMmTpC3Sf4XBCCVvZ

# 时区配置
TZ=Asia/Shanghai
