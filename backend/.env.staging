# Staging Environment Configuration
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:opennie%40123@lumingcurated.cn:5432/postgres_staging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://:opennie%40123@47.98.234.55:6379/1
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true

# Security Configuration
SECRET_KEY=${STAGING_SECRET_KEY}
JWT_SECRET_KEY=${STAGING_JWT_SECRET_KEY}
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGINS=https://staging.vibecoding.com
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# File Upload
MAX_FILE_SIZE=20971520  # 20MB
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.xlsx,.csv

# Email Verification - staging环境开启邮件验证
EMAIL_VERIFICATION_ENABLED=true

# Email Configuration - 需要配置实际的邮件服务
SMTP_USERNAME=${STAGING_SMTP_USERNAME}
SMTP_PASSWORD=${STAGING_SMTP_PASSWORD}
EMAIL_FROM=${STAGING_EMAIL_FROM}
EMAIL_FROM_NAME=记账App

# Frontend URL - 用于邮件中的链接
FRONTEND_URL=https://staging.vibecoding.com
