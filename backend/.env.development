# Development Environment Configuration
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:opennie%40123@lumingcurated.cn:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://:opennie%40123@47.98.234.55:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_RETRY_ON_TIMEOUT=true

# Security Configuration
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=detailed

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.xlsx,.csv

# Email Verification - 开发环境关闭邮件验证
EMAIL_VERIFICATION_ENABLED=false

# Email Configuration - 需要配置实际的邮件服务
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=记账App开发团队

# Frontend URL - 用于邮件中的链接
FRONTEND_URL=http://localhost:3000
